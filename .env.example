# Copy this file to .env. These values target the local Ollama daemon.

# Both roles use Ollama's OpenAI-compatible endpoint. The API key is a
# non-secret compatibility value required by OpenAI clients.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CONTAINER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_TARGET_MODEL=qwen3:8b
OLLAMA_MUTATOR_MODEL=qwen3:14b

# This setting belongs to the Ollama server process. Restart Ollama after
# setting it so RSIHub's n_concurrent=2 matches the local server.
OLLAMA_NUM_PARALLEL=2

# First-round execution settings.
EXPERIMENT_MAX_GENERATIONS=3
EXPERIMENT_CHILDREN_PER_GENERATION=1
EXPERIMENT_MAX_CONCURRENCY=2
EXPERIMENT_TASK_TIMEOUT_SECONDS=600
